{
  "$schema": "https://secretlint.github.io/schema.json",
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    }
  ],
  "ignores": [
    "**/node_modules/**",
    "**/.next/**",
    "**/coverage/**",
    "**/dist/**",
    "**/build/**",
    "**/*.log",
    "**/package-lock.json",
    "**/bun.lock",
    "**/public/fonts/**",
    "public/.well-known/farcaster.json",
    "scripts/test-*.js",
    "scripts/standalone-*.js",
    "scripts/send-intro-cast.js",
    "scripts/send-image-cast.js",
    "scripts/test-farcaster-webhook.js"
  ]
}
